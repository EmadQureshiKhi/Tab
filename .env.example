# Tab, environment template.
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored; this
# template is the tracked contract. Every variable the workspace reads appears
# here, because CI extracts every `process.env.*` and `vm.envOr` reference and
# fails the build when one is missing from this file.
#
# Each block notes its consumers. Non-secret variables carry a real example
# value. Secret variables carry a shape hint only, never a real or realistic
# value, and never anything that could be mistaken for one.

# ---------------------------------------------------------------- Monad
# Consumers: all
# Testnet is chain 10143. Mainnet is chain 143 at https://rpc.monad.xyz with the
# explorer at https://monadvision.com.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# Consumers: contracts (the `foundry.toml` rpc aliases)
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# Consumers: app, sdk, docs
MONAD_EXPLORER_URL=https://testnet.monadvision.com

# ---------------------------------------------------------------- Contract addresses
# Consumers: all but the Dashboard, which carries both networks' addresses
# built in (see the Dashboard block below)
# Every one of these is deployed and recorded in `deployments.json`, with the
# address read back off the chain. This template still carries the zero-address
# placeholder because it is the tracked contract for variable *names* and not a
# source of values. To get a `.env` with the recorded addresses already in it:
#     pnpm env:bootstrap
SERVICE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
BOND_ADDRESS=0x0000000000000000000000000000000000000000
TAB_BOOK_ADDRESS=0x0000000000000000000000000000000000000000
TAB_SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000
# The mintable six-decimal test token the deploy script ships to Testnet for
# demos. On Mainnet the Assets are USDC and AUSD, and this stays empty.
MOCK_USDC_ADDRESS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------- Deployment roles
# Consumers: contracts
# Address permitted to queue a promotion into the Curated Tier. A constructor
# argument of `ServiceRegistry`, chosen once and never settable afterwards. It
# gates Credit Limit weight and nothing else: no power over metering, tabs, or
# Bonds. A `CurationMultisig` address satisfies it.
# The curation authority's owner set, when that authority is a CurationMultisig.
# The contract takes its owners in its constructor and exposes no setter, so the
# set is fixed for the life of a deployment and can only change at a new one.
# Only a tier change answers to them: no Agent's funds, tab or Settlement can be
# touched with these. Consumers: contracts (scripts)
CURATION_OWNER_1_ADDRESS=0x0000000000000000000000000000000000000000
CURATION_OWNER_2_ADDRESS=0x0000000000000000000000000000000000000000
CURATION_OWNER_2_PRIVATE_KEY=
CURATION_OWNER_3_ADDRESS=0x0000000000000000000000000000000000000000
CURATION_OWNER_3_PRIVATE_KEY=
# How many of the owners must approve. 2 of 3 is what a Mainnet deployment uses.
CURATION_THRESHOLD=2
CURATION_AUTHORITY_ADDRESS=0x0000000000000000000000000000000000000000
# Consumers: contracts
# `true` deploys `MockUsdc` alongside the core contracts. Testnet only.
DEPLOY_MOCK_USDC=false

# ---------------------------------------------------------------- Endpoints
# Consumers: sdk
GATEWAY_URL=http://localhost:8788
# Consumers: registry, sdk
RPC_BATCH_MAX_COUNT=1

# ---------------------------------------------------------------- Metering gateway
# Consumers: gateway
GATEWAY_PORT=8788
# Every metered request must be signed, by the Service operator (the Service's
# own front vouching for a caller it authenticated) or by the Agent it is metered
# against (tab.config's agentSignedMetering does this per call). `false` accepts
# unsigned requests and is for a machine nobody else can reach.
GATEWAY_REQUIRE_SIGNATURE=true
# How long a metered call waits for its delivery's receipt before answering
# without a charge block. It must stay under what a caller will wait: the
# response is held until the charge is recorded, so a Service that waits
# longer than its callers bills them for work they never receive. The SDK's
# tab_call allows 30s by default, so 20s leaves room for the answer to travel.
GATEWAY_RECEIPT_WAIT_MS=20000
# The Asset the gateway meters in. Falls back to MOCK_USDC_ADDRESS on Testnet.
GATEWAY_ASSET_ADDRESS=
# The priced tool the gateway serves, and its price in Asset base units.
GATEWAY_TOOL=quote.generate
GATEWAY_PRICE_BASE_UNITS=10000

# ---------------------------------------------------------------- Dashboard trial call
# Consumers: app (on the MONAD_CHAIN_ID network, beside TRY_IT_AGENT_TESTNET
# and TRY_IT_AGENT_MAINNET below), sdk (tab.config's Agent)
TRY_IT_AGENT=0x0000000000000000000000000000000000000000
GATEWAY_SERVICE_ID=0x7461622e64656d6f000000000000000000000000000000000000000000000000

# ---------------------------------------------------------------- Registry read API
# Consumers: registry
REGISTRY_PORT=8787
# Consumers: sdk, agent-wallet-plugin
# With nothing else configured, the SDK and the plugin read this project's
# hosted registry and call its hosted demo Service. `off` makes them reach
# nothing they were not told about.
TAB_HOSTED_DEFAULTS=
# Consumers: registry, gateway
# The block the contracts were deployed in. Nothing before it can carry a Tab log.
REGISTRY_START_BLOCK=64554587
REGISTRY_POLL_INTERVAL_MS=2000
# Monad's public RPC caps eth_getLogs at 100 blocks per request.
REGISTRY_LOG_CHUNK_BLOCKS=100
REGISTRY_REORG_WINDOW_BLOCKS=32

# ---------------------------------------------------------------- Credit parameters
# Consumers: registry, gateway
DEFAULT_SETTLEMENT_WINDOW_S=21600
# Consumers: contracts, sdk
CREDIT_BASELINE_BASE_UNITS=5000000
GROWTH_FACTOR_BPS=5000

# ---------------------------------------------------------------- Browser suite
# Consumers: app
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# The port `playwright.config.ts` starts the built app on for the run.
E2E_PORT=3070

# ---------------------------------------------------------------- Operations
# Consumers: registry
# Every address this project controls, for the /adoption split. Defaults to
# team-addresses.json at the root.
TEAM_ADDRESSES_PATH=
# Consumers: gateway, registry
TAB_BUILD_COMMIT=
TAB_BUILD_VERSION=0.0.0

# ---------------------------------------------------------------- Presentation
# Consumers: app, sdk, gateway
# The gateway reads an Agent's witness from here on first sight instead of
# scanning logs from the deployment block; unset, every first witness is a scan.
NEXT_PUBLIC_REGISTRY_API_URL=http://localhost:8787
NEXT_PUBLIC_DOCS_URL=http://localhost:3001
# Consumers: app (the base every social-card URL resolves against), docs
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Consumers: docs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The Agent address tab_call meters against when no tab.config names one. Public,
# so `tab connect` copies it into the MCP stanza. Consumers: sdk
AGENT_ADDRESS=

# ---------------------------------------------------------------- SECRETS, shape hints only
# Consumers: registry
DATABASE_URL=
# The registry's route tests run against a database of their own, never the live
# index: this one when set, otherwise `<database>_test` beside it, created on
# first run. Consumers: registry (tests)
REGISTRY_TEST_DATABASE_URL=
# Consumers: contracts
DEPLOYER_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY
# Consumers: gateway
GATEWAY_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY
# Consumers: sdk, scripts
AGENT_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY

# ---------------------------------------------------------------- Local tooling
# Consumers: contracts
FORGE_BIN=

# ---------------------------------------------------------------- Registry log source (Envio HyperSync)
# Consumers: registry
# Set HYPERSYNC_URL to read catch-up ranges from Envio's HyperSync archive
# instead of 100-block eth_getLogs calls against the public RPC. Testnet is
# https://monad-testnet.hypersync.xyz and Mainnet is https://monad.hypersync.xyz.
# The RPC still answers the head, the live window and any range the archive
# cannot; leave the URL empty to read everything from the RPC.
HYPERSYNC_URL=
# Ranges ending within this many blocks of the head are read from the RPC.
HYPERSYNC_LIVE_WINDOW_BLOCKS=512
# Blocks per HyperSync request during catch-up.
HYPERSYNC_CHUNK_BLOCKS=100000

# ---------------------------------------------------------------- ERC-8004 identity
# Consumers: registry, contracts (script/03 registers on the Identity registry)
# Both default to the canonical registries for MONAD_CHAIN_ID, so leave them
# empty on Monad. Set the Identity registry to the zero address to switch
# identity indexing off; that is the one place the zero address is an
# instruction rather than an unfilled placeholder.
ERC8004_IDENTITY_REGISTRY_ADDRESS=
ERC8004_REPUTATION_REGISTRY_ADDRESS=

# ---------------------------------------------------------------- Nansen labels
# Consumers: registry
# The Nansen chain slug the label lookup is scoped to. `all` searches every
# chain that shares the address format, `monad` narrows it to Monad.
NANSEN_CHAIN=all

# ---------------------------------------------------------------- SECRETS, shape hints only (continued)
# Consumers: registry
# HyperSync's public instances answer /query only with a token, from
# https://app.envio.dev/api-tokens. Without one the registry falls back to the RPC.
HYPERSYNC_API_TOKEN=
# Consumers: registry
# With no key, /agents/:address serves labels as a stated NANSEN_KEY_MISSING.
NANSEN_API_KEY=

# ---------------------------------------------------------------- Dashboard, one set per network
# Consumers: app
# The Dashboard serves Testnet and Mainnet from one deployment and the visitor
# picks which; MONAD_CHAIN_ID above is only the network shown before they do.
# Contract addresses are built into the app from `deployments.json`, so what is
# configured here is only where each network is read from. The unsuffixed
# NEXT_PUBLIC_REGISTRY_API_URL, MONAD_RPC_URL, MONAD_EXPLORER_URL and
# TRY_IT_AGENT still apply, to the MONAD_CHAIN_ID network only; a network with
# no registry URL of its own and no fallback says so instead of reading another
# network's index.
# The registry read API for each network, each over its own database.
NEXT_PUBLIC_REGISTRY_API_URL_TESTNET=http://localhost:8787
NEXT_PUBLIC_REGISTRY_API_URL_MAINNET=
# Optional. Unset, each network uses its public endpoint. The endpoint reaches
# the browser, where a passkey account signs and reads its balance through it,
# so never put a keyed URL here.
MONAD_RPC_URL_TESTNET=
MONAD_RPC_URL_MAINNET=
# The Agent a trial call on each network is billed to. GATEWAY_PRIVATE_KEY signs
# the metering claim on both, since the demo Service has one operator.
TRY_IT_AGENT_TESTNET=
TRY_IT_AGENT_MAINNET=
# A Mainnet trial call spends real gas and puts a real charge on the demo
# Agent's tab, so it is limited per client address per minute and per day for
# the whole site. Held in memory, so on a serverless host each warm instance
# counts on its own. 0 switches Mainnet trial calls off. Testnet is limited
# loosely and needs no setting.
TRY_IT_MAINNET_PER_IP_PER_MINUTE=3
TRY_IT_MAINNET_PER_DAY=100

# ---------------------------------------------------------------- Permit2 and the canonical USDC
# Consumers: contracts, sdk
# Uniswap's Permit2 at its canonical address, the same on Monad Mainnet and
# Testnet. `TabSettlement` is immutable over it: an Agent approves Permit2 once
# and signs its Settlements thereafter, and anyone may submit the signature. A
# network constant rather than a deployment output, so it is not recorded in
# `deployments.json`.
PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
# Consumers: contracts (script/04), gateway, sdk
# Circle's USDC on the configured chain, accepted by the demo Service beside
# MockUsdc. Testnet: 0x534b2f3A21130d7a60830c2Df862319e593943A3 (20 USDC per
# address every two hours from https://faucet.circle.com). Mainnet:
# 0x754704Bc059F8C67012fEd69BC8A327a5aafb603. Empty registers the demo Service
# without it.
USDC_ADDRESS=0x534b2f3A21130d7a60830c2Df862319e593943A3

# ---------------------------------------------------------------- ERC-8004 registration (script/03)
# Consumers: contracts
# The registration files the demo Service and the demo Agent are registered
# with on the chain's Identity Registry. Any URI the specification allows:
# https://, ipfs://, or data:application/json;base64,... for a card held fully
# on chain. Changing one and re-running the script rewrites the registered URI
# in place.
ERC8004_SERVICE_AGENT_URI=https://tab.example/.well-known/agent-registration.json
ERC8004_AGENT_URI=https://tab.example/agent/.well-known/agent-registration.json
# The agentIds the first run minted, printed by the script. Leave them empty
# until then; once set, the script keeps those identities and refuses to mint a
# duplicate.
ERC8004_SERVICE_AGENT_ID=
ERC8004_AGENT_ID=

# ---------------------------------------------------------------- x402 (gateway)
# Consumers: gateway
# A 402 on LimitExceeded also carries an x402 PAYMENT-REQUIRED offer for the
# same charge, and a request carrying PAYMENT-SIGNATURE is prepaid through the
# facilitator and never metered. `false` switches both off.
X402_ENABLED=true
# Monad's facilitator settles `exact` (EIP-3009) on eip155:143 and eip155:10143.
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
# Where a prepaid call's funds go when ServiceRegistry.collectionOf cannot be
# read at startup. The registry is read first; this is the fallback only.
GATEWAY_COLLECTION_ADDRESS=
# The x402 upstreams the gateway fronts at /hub/<prefix>/*, as a JSON array of
# { prefix, url, tool, marginBps?, marginBaseUnits?, maxUpstreamBaseUnits? }.
# The gateway pays each upstream with its own key and meters the Agent for the
# upstream price plus the margin. Empty means no hub routes.
# `nansen` fronts Nansen's own x402 API (Monad Mainnet USDC, $0.01 to $0.05 a
# call); `apihub` fronts the API Hub's run endpoint, which takes
# { provider, endpoint, input } in the body and serves dozens of providers. Both take
# USDC on Monad Mainnet and nothing else, so `payOn` names that chain and Asset:
# the paying key (GATEWAY_X402_PRIVATE_KEY, or the operator key) must hold USDC
# there, and the Agent is metered here in the Service's own Asset, base unit for
# base unit. Leave `payOn` out for an upstream paid on the Service's own chain.
GATEWAY_HUB_UPSTREAMS=[{"prefix":"nansen","url":"https://api.nansen.ai/api/v1","tool":"nansen.query","marginBps":500,"payOn":{"chainId":143,"asset":"0x754704Bc059F8C67012fEd69BC8A327a5aafb603"}},{"prefix":"apihub","url":"https://x402.monid.ai/v1","tool":"apihub.run","marginBps":500,"payOn":{"chainId":143,"asset":"0x754704Bc059F8C67012fEd69BC8A327a5aafb603"}}]
# The tools a fronted mount meters under, and what one unit of each costs in the
# applied price list. Read by script/05_PriceFrontedTools.s.sol, which publishes
# them: a fronted call's price is not known until the upstream answers and
# TabBook refuses a unit price the registry does not hold, so the amount rides
# in the unit count at this price. Consumers: contracts (scripts)
GATEWAY_HUB_TOOLS=apihub.run,nansen.query
GATEWAY_HUB_UNIT_BASE_UNITS=1

# ---------------------------------------------------------------- SECRETS, shape hints only (x402)
# Consumers: gateway
# The key that pays fronted upstreams. Optional: the operator key pays when this
# is unset. Never written to a configuration file.
GATEWAY_X402_PRIVATE_KEY=

# ---------------------------------------------------------------- Delinquency keeper
# Consumers: keeper
# The permissionless `TabBook.markDelinquent` cranker (`apps/keeper`). It also
# reads MONAD_RPC_URL, MONAD_CHAIN_ID, TAB_BOOK_ADDRESS, SERVICE_REGISTRY_ADDRESS
# and NEXT_PUBLIC_REGISTRY_API_URL from the blocks above. The MetaMask Agent
# Wallet plugin (`packages/agent-wallet-plugin`) reads TAB_BOOK_ADDRESS,
# TAB_SETTLEMENT_ADDRESS, NEXT_PUBLIC_REGISTRY_API_URL, MONAD_CHAIN_ID,
# MONAD_RPC_URL and MONAD_EXPLORER_URL from those blocks and nothing else.
KEEPER_PORT=8791
# How many pages of /deliveries one tick will walk before it refuses to judge.
KEEPER_MAX_FEED_PAGES=200

# ---------------------------------------------------------------- SECRETS, shape hints only (keeper)
# Consumers: keeper
# Read only when a mark is sent. Unset, `once` is a dry run and `serve` refuses
# to broadcast. Needs MON for gas and nothing else; it holds no Asset.
KEEPER_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY
# Consumers: keeper, cre-keeper (as the Vault DON secret of the same name)
# Guards `POST /tick`. Unset, the route is refused outright. The CRE workflow in
# `apps/cre-keeper` reads it through `secrets.yaml` under the same name.
KEEPER_SHARED_SECRET=

# ---------------------------------------------------------------- Chainlink CRE
# Consumers: cre-keeper (the simulator, not the workflow)
# `cre workflow simulate` asks for a signing key even for a workflow that writes
# nothing on chain. 64 hex characters, no 0x prefix. Unfunded is fine: this
# workflow decides and the keeper sends. Keep it out of any committed file.
CRE_ETH_PRIVATE_KEY=
# Where a CRE simulation reads KEEPER_SHARED_SECRET from. The same value, under
# a different name: the simulator warns when a secret's id and the variable
# carrying it are spelled the same, because a change to one then looks like a
# change to the other. Consumers: cre-keeper (the simulator)
CRE_KEEPER_SHARED_SECRET=

# ---------------------------------------------------------------- Settlement relay
# Consumers: gateway
# The gateway submits any Agent's Permit2-signed Settlement with this Service and
# pays the gas, so an Agent needs no MON to settle. On whenever
# TAB_SETTLEMENT_ADDRESS is set; `false` switches it off.
GATEWAY_RELAY_ENABLED=true
