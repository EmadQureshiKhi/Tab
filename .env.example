# Tab — environment template.
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored; this
# template is the tracked contract. Every variable the workspace reads appears
# here, because CI extracts every `process.env.*` and `vm.envOr` reference and
# fails the build when one is missing from this file.
#
# Each block notes its consumers. Non-secret variables carry a real example
# value. Secret variables carry a shape hint only — never a real or
# realistic value, and never anything that could be mistaken for one.

# ---------------------------------------------------------------- Creditcoin CC3 Testnet
# Consumers: all
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031
# Consumers: app, sdk
CREDITCOIN_EXPLORER_URL=https://creditcoin-testnet.blockscout.com

# ---------------------------------------------------------------- Precompiles
# Consumers: contracts, watcher
BLOCKPROVER_PRECOMPILE=0x0000000000000000000000000000000000000FD2
# Consumers: watcher, app
CHAININFO_PRECOMPILE=0x0000000000000000000000000000000000000fd3

# ---------------------------------------------------------------- Attestcoin Protocol services
# Consumers: watcher, proof-service
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
# Consumers: docs, app
ASC_DASHBOARD_URL=https://dashboard.cc3-testnet.creditcoin.network

# ---------------------------------------------------------------- Creditcoin contract addresses
# Consumers: all
# Every one of these is deployed and recorded in `deployments.json`, with the
# address read back off the chain. This template still carries the zero-address
# placeholder because it is the tracked contract for variable *names* and not a
# source of values. To get a `.env` with the recorded addresses already in it:
#     pnpm env:bootstrap
SETTLEMENT_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
TAB_BOOK_ADDRESS=0x0000000000000000000000000000000000000000
SERVICE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
AGENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
BOND_ADDRESS=0x0000000000000000000000000000000000000000
# Consumers: contracts
# `EvmV1Decoder` exposes public functions, so every consumer links against a
# deployed copy of it. Step 1 of the deployment prints this address and step 3
# passes it to `forge script --libraries`; step 7 refuses to pass unless it
# holds code, which is what catches a forgotten or mistyped linkage flag.
DECODER_LIBRARY_ADDRESS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------- Deployment roles
# Consumers: contracts
# Address permitted to queue a promotion into the Curated Tier. A constructor
# argument of `ServiceRegistry`, chosen once and never settable afterwards. It
# gates Credit Limit weight and nothing else: no power over metering, tabs, or
# Bonds. A multisig address satisfies it.
CURATION_AUTHORITY_ADDRESS=0x0000000000000000000000000000000000000000

# The 2-of-3 multisig that takes the curation role at the next deployment of
# ServiceRegistry. It holds no role today and cannot be given one: the registry
# takes its authority as a constructor argument and has no setter.
CURATION_MULTISIG_ADDRESS=0x9fCe693cD68307a2450aB57f4654653643F01Bb6
# Consumers: contracts, watcher
# Account permitted to apply Provisional Clearings and report reorganisations.
# The public address of WATCHER_PRIVATE_KEY, declared separately so the
# deployment scripts and the read-back never touch the key itself.
WATCHER_ADDRESS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------- Source chain surfaces
# Consumers: sdk, watcher
# chainKey 1 is Ethereum Sepolia, chainKey 3 is Ethereum Mainnet.
# The Sepolia settlement contract is not deployed yet.
SEPOLIA_SETTLEMENT_ADDRESS=0x0000000000000000000000000000000000000000
MAINNET_USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
SEPOLIA_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Consumers: contracts, proof-service
# Where the Proof Service collects Settlements, and where its Bond is funded.
# The collection table is keyed by (chainKey, address), so one account serves
# both Sepolia and Mainnet. Within one chain a claim is exclusive, so the two
# addresses below must differ from each other; the registration script refuses
# them by name if they do not.
PROOF_SERVICE_COLLECTION_ADDRESS=0x0000000000000000000000000000000000000000
BOND_COLLECTION_ADDRESS=0x0000000000000000000000000000000000000000
# Consumers: watcher
# Comma-separated list of RPC endpoints, highest priority first.
# Order endpoints by measured `eth_getLogs` range capability, not by latency:
# most free endpoints cap the window far below the catch-up chunk size.
ETHEREUM_MAINNET_RPC_URLS=https://rpc1.example,https://rpc2.example
ETHEREUM_SEPOLIA_RPC_URLS=https://rpc1.example,https://rpc2.example

# Consumers: watcher, sdk
# Several public endpoints reject JSON-RPC batching outright. Set to 1 to send
# one call per request.
RPC_BATCH_MAX_COUNT=1

# Consumers: sdk
# Where the metering gateway can be reached, read by `tab.config.mjs` to give the
# registered Service an endpoint. The chain records no URL for a Service on
# purpose, so this is the only place one lives.
GATEWAY_URL=http://localhost:8788

# Consumers: app
# Where the Proof Service can be reached. A separate process from the gateway and
# on its own address: the gateway meters `/meter/*`, the Proof Service serves
# `/proof/*`, and the Dashboard's trial call offers both.
PROOF_SERVICE_URL=http://localhost:8789

# ---------------------------------------------------------------- Watcher tuning
# Consumers: watcher
WATCHER_BATCH_MAX_PROOFS=10
WATCHER_BATCH_MAX_SPAN=1000
WATCHER_BACKOFF_MIN_MS=2000
WATCHER_BACKOFF_MAX_MS=300000
WATCHER_ENDPOINT_FAILURE_THRESHOLD=3
# Adaptive `eth_getLogs` window for gap catch-up. The window starts at MAX,
# halves whenever an endpoint rejects the request on range or result volume, and
# never narrows below MIN, so a single dense block always stays reachable.
WATCHER_LOG_CHUNK_MAX=2000
WATCHER_LOG_CHUNK_MIN=1

# ---------------------------------------------------------------- Metering gateway
# Consumers: gateway
# Port the metering service listens on.
GATEWAY_PORT=8788
# Accept metered requests without an operator signature. Defaults to requiring
# one; set to false only for a local demonstration where the caller is the
# operator. Every metered call records a delivery on chain and spends gas, so a
# reachable gateway with this off is one anybody can bill.
GATEWAY_REQUIRE_SIGNATURE=true

# ---------------------------------------------------------------- Dashboard trial call
# Consumers: app
# The Agent a "try it" call on /browse is billed to. Absent, the button reports
# that this deployment offers no trial rather than billing somebody. A charge
# lands on this Agent's Open Tab, so it must be one this project controls.
TRY_IT_AGENT=0x0000000000000000000000000000000000000000
# The Service this gateway meters for, as the 32-byte registry key. The value
# below is `tab.proof-service`, left-aligned and zero-padded, which is how
# `ServiceRegistry` stores a short ascii name. The gateway signs with the
# Service operator key, so this id and that key must name the same Service or
# every `recordDelivery` reverts `NotServiceOperator`.
GATEWAY_SERVICE_ID=0x7461622e70726f6f662d73657276696365000000000000000000000000000000

# ---------------------------------------------------------------- Registry read API
# Consumers: registry
# Port the Hono service listens on. `/healthz` and `/readyz` are unauthenticated,
# because every field either restates a public chain fact or reports the
# process's own liveness.
REGISTRY_PORT=8787
# First Creditcoin block the indexer scans on a cold start. Set it to the
# deployment block of the earliest watched contract — `deployments.json` carries
# the deployment transaction hashes to derive it from. Lower costs a long
# catch-up; higher silently loses history.
REGISTRY_START_BLOCK=5407360
# Pause between polls once the indexer has caught up to the head. Behind the
# head it does not pause at all, so catch-up runs at chunk speed.
REGISTRY_POLL_INTERVAL_MS=5000
# Blocks per `eth_getLogs` request during catch-up.
REGISTRY_LOG_CHUNK_BLOCKS=2000
# Blocks re-scanned and rewritten on every poll. This is what makes indexing
# reorganisation-tolerant: anything a previous pass recorded from a branch that
# lost is deleted and rewritten, with no detection step needed. Deeper
# reorganisations are caught by an anchor check against already-indexed blocks.
REGISTRY_REORG_WINDOW_BLOCKS=32

# ---------------------------------------------------------------- Clearing and credit parameters
# Consumers: watcher, contracts
CLEARING_DEADLINE_CHAINKEY_1_S=1800
CLEARING_DEADLINE_CHAINKEY_3_S=3600
# Consumers: registry, gateway
DEFAULT_SETTLEMENT_WINDOW_S=21600
# Consumers: contracts, sdk
# Integer base units of the Asset. USDC has 6 decimals, so 5000000 is 5.00 USDC.
CREDIT_BASELINE_BASE_UNITS=5000000
GROWTH_FACTOR_BPS=5000
# Consumers: proof-service
PROOF_SERVICE_PRICE_BASE_UNITS=10000

# ---------------------------------------------------------------- Browser suite
# Consumers: app
# Both are unset in the normal case. `pnpm e2e` sets them for the length of a run.
# Port the Playwright suite serves the Dashboard on while it runs. Unset means 3070.
E2E_PORT=
# Path to a Chromium binary. Unset means Playwright looks where it normally would,
# which is what a supported host should do. It is set only on a host Playwright ships
# no browser for, where `scripts/e2e.sh` supplies one and its libraries without root.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# ---------------------------------------------------------------- Operations
# Consumers: registry
# Where the internal-address allowlist lives. Unset is the normal case: the service
# walks up from its own module to find `team-addresses.json` at the repository root,
# which is robust to being started from a workspace directory. Set it only when the
# file lives somewhere else. A deployment that cannot read it serves everything except
# `GET /adoption`, because publishing that split under an empty allowlist would report
# every address as external.
TEAM_ADDRESSES_PATH=

# Consumers: watcher
# Port the unauthenticated health server binds. Nothing here authenticates, so the
# port should be reachable by the orchestrator and not by the public internet.
WATCHER_HEALTH_PORT=8081
# Consumers: watcher
# Build provenance reported by `GET /healthz`, so a report can be tied to the code
# that produced it. Both are optional: a missing commit is reported as null rather
# than as the string "unknown", which would read like a revision and is not one.
TAB_BUILD_COMMIT=
TAB_BUILD_VERSION=0.0.0

# ---------------------------------------------------------------- Presentation
# Consumers: app
NEXT_PUBLIC_REGISTRY_API_URL=https://registry.example
# The Documentation Site, published as a separate project and domain from the
# Dashboard, which is what the Dashboard links to.
NEXT_PUBLIC_DOCS_URL=https://docs.tab.example
# Consumers: docs
# Where the Dashboard lives, so the Documentation Site's masthead can link back to
# it. The two are separate projects on separate domains, so neither can derive the
# other's address and both are told.
NEXT_PUBLIC_APP_URL=https://tab.example
NEXT_PUBLIC_SITE_URL=https://tab.example

# ---------------------------------------------------------------- SECRETS — shape hints only
# Nothing below carries a usable value. Fill each one in your local `.env`.

# Consumers: watcher, registry
# Shape: postgres://USER:PASSWORD@HOSTNAME:5432/DATABASE
# Two ways to get a local one, neither preferred over the other:
#   Docker      docker compose up -d db          (compose file at the repository root)
#               -> postgres://tab:tab@127.0.0.1:5432/tab
#   No Docker   winget install PostgreSQL.PostgreSQL.17
#               -> postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/postgres
#               The installer prompts for the superuser password and puts psql on
#               PATH under C:\Program Files\PostgreSQL\17\bin.
# Either way, apply the schema with `pnpm --filter @tabai/registry db:apply`, which
# is idempotent, so a failed first run costs a re-run and nothing else.
DATABASE_URL=

# Signing keys. Shape: `0x` followed by exactly 64 hexadecimal characters.
# The placeholder below is deliberately not hexadecimal, so an unfilled value
# fails fast instead of looking like a key.
# Consumers: watcher
WATCHER_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY
# Consumers: gateway
GATEWAY_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY
# Consumers: proof-service
PROOF_SERVICE_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY
# Consumers: sdk, examples
AGENT_ETHEREUM_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY
# Consumers: examples
# The Agent's own Creditcoin account: it requests bindings and sets spending
# authorisations. Its address is derived from the key and is never recorded
# separately, so nothing has to be kept in step with it.
AGENT_CREDITCOIN_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY

# Consumers: CI only
# Shape: newline-separated terms. Supplied from a repository secret and
# materialised into the gitignored `.vocabulary-denylist` file at job start.
VOCAB_DENYLIST=

# ---------------------------------------------------------------- Agent demo
# Consumers: examples
# `examples/agent-demo` runs two agents against the deployed rail. Its default
# mode reads and simulates only, and that mode must work for somebody holding no
# key at all, so each Agent's addresses are declared here rather than derived
# from a key the way `AGENT_CREDITCOIN_PRIVATE_KEY` is. The demo refuses to start
# on the zero address, because the deployment slots above ship as zero and an
# unfilled copy would otherwise fail much later as a call to an account with no
# code.
#
# Agent one is the Agent the rest of the workspace already knows: these two
# addresses are the public halves of AGENT_CREDITCOIN_PRIVATE_KEY and
# AGENT_ETHEREUM_PRIVATE_KEY.
DEMO_AGENT_ONE_CREDITCOIN_ADDRESS=0x0000000000000000000000000000000000000000
DEMO_AGENT_ONE_ETHEREUM_ADDRESS=0x0000000000000000000000000000000000000000
# Agent two exists so the demo has a second, independent party. It must be a
# different Creditcoin address from agent one or the demo refuses: two agents
# that are one Agent make nothing in the story observable.
DEMO_AGENT_TWO_CREDITCOIN_ADDRESS=0x0000000000000000000000000000000000000000
DEMO_AGENT_TWO_ETHEREUM_ADDRESS=0x0000000000000000000000000000000000000000
# A Source Chain contract that holds the Asset on agent two's behalf. It is the
# address in `topics[1]` when it pays, while the transaction sender is agent
# one's wallet, and act four asserts the credit lands on the Agent bound to the
# former. Optional: acts one to three run without it and act four refuses by
# name. `packages/contracts/test/live/SourceRelay.sol` is the deployed contract
# this points at.
DEMO_AGENT_TWO_SMART_ACCOUNT_ADDRESS=0x0000000000000000000000000000000000000000
# Consumers: examples
# Agent two's signing keys, needed only by `--broadcast`.
DEMO_AGENT_TWO_CREDITCOIN_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY
DEMO_AGENT_TWO_ETHEREUM_PRIVATE_KEY=0xREPLACE_WITH_YOUR_OWN_64_HEX_CHARACTER_KEY

# ---------------------------------------------------------------- Local tooling
# Consumers: contracts
# Where the `forge` binary is, if it is somewhere unusual. Leave this unset on
# any ordinary install: `packages/contracts/tools/forge.mjs` already looks on
# PATH and in `~/.foundry/bin`, which is where foundryup puts it. It is here
# because foundryup adds that directory to PATH by editing a shell rc file, and
# rc files are read by interactive shells only - so `forge` is present in a
# terminal and absent from every npm script, turbo task and CI step, which is
# what the resolver exists to bridge.
FORGE_BIN=
