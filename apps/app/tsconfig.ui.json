{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["react"],
    "rootDir": "components",
    "outDir": "dist/components",
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo-ui"
  },
  "include": ["components/ui/**/*.ts", "components/ui/**/*.tsx"]
}
