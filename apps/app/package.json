{
  "name": "@tabai/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard. Every read-only route resolves without a wallet connection.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -b tsconfig.json tsconfig.ui.json tsconfig.custom-ui.json && tsc -p tsconfig.next.json",
    "build:site": "next build",
    "dev": "next dev --port 3000",
    "dev:env": "node --env-file=../../.env node_modules/next/dist/bin/next dev --port 3000",
    "start": "next start --port 3000",
    "serve": "node --env-file=../../.env node_modules/next/dist/bin/next start --port 3000",
    "typecheck": "tsc -b tsconfig.json tsconfig.ui.json tsconfig.custom-ui.json && tsc -p tsconfig.next.json",
    "test": "tsc -b tsconfig.json tsconfig.ui.json tsconfig.custom-ui.json && node --test test/theme.test.mjs test/ui.test.mjs test/motion.test.mjs && TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test test/custom-ui.test.ts test/dashboard.test.ts test/dashboard-lane-g.test.ts test/registration.test.ts",
    "lint": "tsx src/theme/check-contrast.ts",
    "theme:tokens": "tsx src/theme/generate-tokens.ts",
    "audit:visual": "node test/visual/audit.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.14",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tooltip": "1.2.7",
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "@react-three/postprocessing": "3.0.4",
    "@tabai/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "ethers": "6.17.0",
    "gsap": "3.13.0",
    "lenis": "1.3.11",
    "lucide-react": "0.525.0",
    "motion": "12.23.22",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.1",
    "three": "0.181.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.181.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "tw-animate-css": "1.3.5"
  }
}
