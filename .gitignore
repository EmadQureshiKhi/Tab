# ---------------------------------------------------------------- dependencies
node_modules/
.pnpm-store/

# Foundry pulls its Solidity dependencies into the project's own `lib/`.
# Scoped to the Foundry project so a source directory named `lib` stays tracked.
packages/contracts/lib/

# ---------------------------------------------------------------- build output
dist/
out/
.next/
cache/
broadcast/
artifacts/
.turbo/
coverage/
lcov.info
*.tsbuildinfo
*.log

# ---------------------------------------------------------------- environment
# Every real value stays local. Only the template is tracked.
.env
.env.*
!.env.example

# ---------------------------------------------------------------- vocabulary gate
# The denylist is materialised locally and in CI, never committed.
.vocabulary-denylist

# ---------------------------------------------------------------- editor and OS
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*~
.idea/
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------- compiler caches
# Foundry's resolved-source cache. The `cache/` rule above catches it inside the
# contracts package, where it lives in `cache/`. It records absolute paths from
# the machine that built it, so it is machine state rather than a build product
# worth keeping.
solidity-files-cache.json


# Playwright run artefacts: traces and error contexts from a local run.
test-results/
playwright-report/

# Fumadocs writes this from content/ on install and build.
apps/docs/.source/

# Windows 'downloaded from the internet' metadata, written beside a file by Explorer.
*:Zone.Identifier

# ---------------------------------------------------------------- packaging and deploys
# `npm pack` output, and the local state directories the hosting CLIs write.
*.tgz
.vercel/
.railway/

# The CRE compiler writes these beside the workflow on every simulate.
.cre_build_tmp.*

# TypeScript emits these beside the sources in apps/app/src; they are build
# output, regenerated by `tsc -b`, and `next-env.d.ts` is the only one a
# framework writes and expects to find committed.
apps/app/src/**/*.d.ts
apps/app/src/**/*.d.ts.map
