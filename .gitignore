# ---------------------------------------------------------------- dependencies
node_modules/
.pnpm-store/

# Foundry pulls its Solidity dependencies into the project's own `lib/`.
# Scoped to the Foundry project so a source directory named `lib` stays tracked.
packages/contracts/lib/

# ---------------------------------------------------------------- build output
dist/
out/
.next/
cache/
broadcast/
artifacts/
.turbo/
coverage/
lcov.info
*.tsbuildinfo
*.log

# ---------------------------------------------------------------- environment
# Every real value stays local. Only the template is tracked.
.env
.env.*
!.env.example

# ---------------------------------------------------------------- vocabulary gate
# The denylist is materialised locally and in CI, never committed.
.vocabulary-denylist

# ---------------------------------------------------------------- local-only working directories
# Never tracked. Local scratch only.
reference-*/

# Spec and planning workspace. Local-only by decision: it records sourcing
# provenance in plain terms, which belongs in the working notes rather than in
# the published history.
.kiro/

# ---------------------------------------------------------------- editor and OS
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*~
.idea/
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------- authoring tools
# Local Python venv for the README art generator. The generated PNGs are
# committed; the venv that produced them is not.
tools/.venv/
__pycache__/
*.py[cod]

# ---------------------------------------------------------------- compiler caches
# Foundry's resolved-source cache. The `cache/` rule above catches it inside the
# product project, where it lives in `cache/`; the spike project writes it to its
# own root instead. It records absolute paths from the machine that built it, so
# it is machine state rather than a build product worth keeping.
solidity-files-cache.json

# ---------------------------------------------------------------- worktree pool
# treehouse places worktrees here when its root is set to ".".
.treehouse/

# Session working material. Reports and probes belong in the agent scratchpad, not the repository.
scratchpad/

# Playwright run artefacts: traces and error contexts from a local run.
test-results/
playwright-report/

# Fumadocs writes this from content/ on install and build.
apps/docs/.source/

# Windows 'downloaded from the internet' metadata, written beside a file by Explorer.
*:Zone.Identifier

# ---------------------------------------------------------------- agent tooling
# Local or generated, and of no use to anyone reading this repository.
# `apps/app/AGENTS.md` is rewritten by `next dev` on every run, so it is ignored
# rather than deleted: deleting it only makes it reappear as an untracked file.
# The walkthrough script for the recorded demonstration. Working material for
# the recording, not something a reader of this repository needs.
demo/

AGENTS.md
CLAUDE.md
**/AGENTS.md
**/CLAUDE.md
.claude/
.cursor/
.windsurf/
.aider*
.github/copilot-instructions.md
treehouse.toml

# ---------------------------------------------------------------- packaging and deploys
# `npm pack` output, and the local state directories the hosting CLIs write.
*.tgz
.vercel/
.railway/
