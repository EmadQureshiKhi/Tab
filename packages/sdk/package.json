{
  "name": "@tabai/sdk",
  "version": "0.2.8",
  "description": "Post-paid billing for autonomous agents on Monad. MCP server, CLI and TypeScript SDK: call a priced tool now, settle in USDC later, and let TabSettlement apply the payment to the tab in the same transaction.",
  "keywords": [
    "monad",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "autonomous-agents",
    "agent-payments",
    "post-paid",
    "billing",
    "credit",
    "402",
    "usdc",
    "sdk",
    "cli"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Emad Qureshi",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./hub": {
      "types": "./dist/x402/hub.d.ts",
      "default": "./dist/x402/hub.js"
    },
    "./metering": {
      "types": "./dist/http/metering-claim.d.ts",
      "default": "./dist/http/metering-claim.js"
    },
    "./x402/client": {
      "types": "./dist/x402/client.d.ts",
      "default": "./dist/x402/client.js"
    }
  },
  "bin": {
    "tab": "./bin/tab.mjs"
  },
  "files": [
    "dist",
    "!dist/**/.tsbuildinfo",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && node --test test/*.test.mjs",
    "bundle": "node scripts/bundle-shared.mjs",
    "prepack": "rm -rf dist && tsc -b --force && node scripts/bundle-shared.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@x402/core": "2.26.0",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@tabai/shared": "workspace:*",
    "@types/node": "22.20.1",
    "tsx": "4.23.15"
  }
}
